# --- ClickUp ---
# Token pessoal do usuário-robô (automacao@voluta.company). Configurações → Apps → API Token
CLICKUP_TOKEN=pk_xxxxxxxx
# Devolvido por `npm run register-webhook`
CLICKUP_WEBHOOK_SECRET=
# ID do usuário-robô (anti-loop: ignora eventos causados pela própria automação)
CLICKUP_BOT_USER_ID=
# ID da lista "ciclo de produção" (número na URL da lista). Várias listas: separe por vírgula
CLICKUP_LIST_IDS=901234567

# --- Estrutura (trechos do nome; sigla, acento e maiúsculas são ignorados) ---
STAGE_APPROVAL=enviar para aprovação
STAGE_SCHEDULE=programar posts
MILESTONE_START=início das publicações
MILESTONE_END=fim das publicações
MILESTONE_PREVIOUS=último post do plano

# --- Regras ---
# Etapa de aprovação concluída (✓) já libera o projeto; estes status também liberam:
APPROVAL_DONE_STATUSES=aprovado,concluído,complete
HOLD_TAGS=fora da agenda
LOCKED_STATUSES=publicado
DEFAULT_INTERVAL_DAYS=2
SCHEDULE_ON_APPROVAL=true
SYNC_MILESTONES=true

# --- Campos personalizados ---
FIELD_CANVA=Link_Canva
FIELD_INTERVAL=Intervalo_Dias
FIELD_FORMAT=Formato
FIELD_THEME=Editoria
FIELD_CLIENT=cliente
FIELD_MONTH=mês
FIELD_CYCLE=ciclo

# --- Dashboard ---
# Opcional: exige ?token=... na URL do dashboard/API
DASHBOARD_TOKEN=
AGENDA_CACHE_SECONDS=60
